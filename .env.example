DATABASE_URL="postgresql://mtg:mtg@localhost:5432/mtg_deck_builder?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# LLM provider selection: "anthropic" (default) or "ollama"
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# --- Docker / Unraid deployment (docker-compose.yml) -------------------------
# Not used by `npm run dev` - DATABASE_URL above is. In Docker, the compose file
# builds DATABASE_URL from POSTGRES_PASSWORD.
POSTGRES_PASSWORD="replace-with-a-strong-password"
# Host port the app is published on (container always listens on 3000).
APP_PORT=3000
# IANA timezone, e.g. America/Chicago. Defaults to UTC.
TZ="UTC"
# For Docker, set NEXTAUTH_URL to the exact address you browse to, e.g.
# http://tower.local:3000 - login breaks if it doesn't match.
