// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  collectionEntries   CollectionEntry[]
  unmatchedImportRows UnmatchedImportRow[]
  decks               Deck[]
}

model Card {
  id                  String            @id @default(cuid())
  name                String            @unique
  manaCost            String?
  manaValue           Float
  colors              String[]
  colorIdentity       String[]
  type                String
  types               String[]
  supertypes          String[]
  subtypes            String[]
  oracleText          String?
  legalities          Json
  scryfallOracleId    String?
  isCommanderEligible Boolean
  priceUsd            Float?
  priceUsdFoil        Float?
  imageUrl            String?
  pricesUpdatedAt     DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  collectionEntries   CollectionEntry[]
  decksAsCommander    Deck[]
  deckCards           DeckCard[]
  deckVersionCards    DeckVersionCard[]
  versionsAsCommander DeckVersion[]
}

model CollectionEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  cardId           String
  card             Card     @relation(fields: [cardId], references: [id])
  quantity         Int
  foil             Boolean  @default(false)
  setCode          String?
  sourceScryfallId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, cardId, foil])
}

model UnmatchedImportRow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rawName   String
  rawSet    String?
  quantity  Int
  foil      Boolean  @default(false)
  status    String   @default("pending") // "pending" | "resolved" | "ignored"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deck {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  name            String
  commanderCardId String?
  commanderCard   Card?         @relation(fields: [commanderCardId], references: [id])
  critique        String?
  description     String?
  goal            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cards           DeckCard[]
  versions        DeckVersion[]
}

model DeckCard {
  id          String   @id @default(cuid())
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id])
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id])
  quantity    Int
  isCommander Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([deckId, cardId])
}

/// A saved snapshot of a deck, like a commit: `description` says what changed
/// since the previous version. `number` counts up per deck from 1.
model DeckVersion {
  id              String            @id @default(cuid())
  deckId          String
  deck            Deck              @relation(fields: [deckId], references: [id])
  number          Int
  description     String
  commanderCardId String?
  commanderCard   Card?             @relation(fields: [commanderCardId], references: [id])
  createdAt       DateTime          @default(now())
  cards           DeckVersionCard[]
  /// Goal the grade was measured against, copied from Deck.goal at grading time.
  gradeGoal       String?
  /// 0-100 overall score: the mean of the category scores in `gradeBreakdown`.
  gradeScore      Int?
  /// Array of { category, score, note }.
  gradeBreakdown  Json?
  gradeSummary    String?

  @@unique([deckId, number])
}

model DeckVersionCard {
  id          String      @id @default(cuid())
  versionId   String
  version     DeckVersion @relation(fields: [versionId], references: [id])
  cardId      String
  card        Card        @relation(fields: [cardId], references: [id])
  quantity    Int
  isCommander Boolean     @default(false)

  @@unique([versionId, cardId])
}
