# Copy to .env on the NAS (next to docker-compose.unraid.yml).
POSTGRES_PASSWORD="replace-with-a-strong-password"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"   # e.g. `openssl rand -base64 32`
# The URL you'll use in the browser, e.g. http://tower.local:3000 or http://192.168.1.50:3000
NEXTAUTH_URL="http://tower.local:3000"
APP_PORT=3000

# LLM provider: "anthropic" or "ollama"
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3"
